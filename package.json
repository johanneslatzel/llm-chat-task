{
    "name": "@johannes.latzel/llm-chat-task",
    "version": "0.3.0",
    "description": "Task pool and task management tools for the llm-chat ecosystem",
    "license": "MIT",
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "author": "Johannes B. Latzel",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/johanneslatzel/llm-chat-task.git"
    },
    "bugs": {
        "url": "https://github.com/johanneslatzel/llm-chat-task/issues"
    },
    "homepage": "https://github.com/johanneslatzel/llm-chat-task#readme",
    "keywords": [
        "llm",
        "chat",
        "task",
        "pool",
        "tool"
    ],
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "prebuild": "rm -rf dist/",
        "prepack": "npm run build",
        "build": "tsc -p tsconfig.build.json",
        "verify": "tsc --noEmit && eslint . --max-warnings 0 && npm run check:lines && vitest run --coverage",
        "audit": "npm audit --audit-level=high",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write 'docs/**/*.md' 'src/**/*.ts' 'tests/**/*.ts'",
        "docs": "docker run --rm -it -p 8000:8000 -v $PWD:/docs squidfunk/mkdocs-material",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "clean:pack": "rm -rf node_modules dist/ package-lock.json && npm cache clean --force && npm install && npm run verify && npm run build && npm pack",
        "clean:install": "rm -rf node_modules dist/ package-lock.json && npm cache clean --force && npm install && npm run verify",
        "prepare": "husky",
        "check:lines": "check-line-limits"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "prettier --write",
            "eslint --max-warnings 0 --no-warn-ignored",
            "vitest related --run"
        ]
    },
    "dependencies": {
        "@johannes.latzel/json-file-store": "^0.1.0",
        "@johannes.latzel/llm-chat": "^0.7.0",
        "async-mutex": "^0.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.4.0",
        "@typescript-eslint/eslint-plugin": "^8.60.0",
        "@typescript-eslint/parser": "^8.60.0",
        "@vitest/coverage-v8": "^4.1.8",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.2",
        "eslint-plugin-n": "^18.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "prettier": "^3.5.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.8",
        "@johannes.latzel/check-line-limits": "^1.0.1"
    }
}
